generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SALES_MANAGER
  TEAM_LEADER
  FINANCE_OFFICER
  FINANCE_HEAD
  CLUSTER_MANAGER
  CEO
  DELIVERY_INCHARGE
  INSURANCE
  ACCOUNTS_DEPT
  SO
}

enum DeliveryStage {
  DI_DOCUMENTS
  INSURANCE
  DI_VAHAAN_ENTRY
  ACCOUNTS_TALLY
  DI_VAHAAN_DONE
  ACCOUNTS_ROAD_TAX
  COMPLETED
}

enum VehicleStatus {
  OPEN
  SOFT_BLOCKED
  HARD_BLOCKED
  EXPIRED
  DELIVERED
}

enum StockStatus {
  BND
  MDDP
  CTDMS
}

enum BlockType {
  SOFT
  HARD
}

enum BlockingStatus {
  ACTIVE
  EXPIRED
  DELIVERED
}

enum PaymentMode {
  CASH
  FINANCE
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  branchCode String?  @unique
  location   String
  createdAt  DateTime @default(now())

  users             User[]
  blockings         BlockingRequest[]
  vehicleRequests   VehicleRequest[]
  physicalVehicles  Vehicle[]          @relation("PhysicalStockBranch")
  stockyardRanks    StockyardRank[]
  deliveryWorkflows DeliveryWorkflow[]
}

// Ranking of stockyard codes by proximity to a branch (1 = nearest), used by the
// "Nearest" vehicle allocation rule.
model StockyardRank {
  id            String @id @default(uuid())
  branch        Branch @relation(fields: [branchId], references: [id])
  branchId      String
  stockyardCode String
  rank          Int

  @@unique([branchId, stockyardCode])
  @@index([branchId])
}

model User {
  id           String   @id @default(uuid())
  loginId      String   @unique
  passwordHash String
  role         Role
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  branch        Branch? @relation(fields: [branchId], references: [id])
  branchId      String?
  clusterNumber Int?    // for CLUSTER_MANAGER role (1-4)

  blockings        BlockingRequest[] @relation("UserBlockings")
  vehicleRequests  VehicleRequest[]
  auditLogs        AuditLog[]
  modelConfigs     ModelConfig[]
  globalConfigs    GlobalConfig[]
}

// ── Car Catalogue ─────────────────────────────────────────────────────────────

model CarModel {
  id          String   @id @default(uuid())
  modelCode   String   @unique
  modelName   String
  description String?
  createdAt   DateTime @default(now())

  suffixes CarSuffix[]
  colours  CarColour[]
}

model CarSuffix {
  id          String  @id @default(uuid())
  suffix      String
  description String?

  carModel   CarModel @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  carModelId String

  @@unique([carModelId, suffix])
}

model CarColour {
  id          String  @id @default(uuid())
  colourCode  String
  colourName  String

  carModel   CarModel @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  carModelId String

  @@unique([carModelId, colourCode])
}

// ── Vehicle (Stock) ───────────────────────────────────────────────────────────

model Vehicle {
  id                String        @id @default(uuid())
  chassisNumber     String        @unique
  chassisYear       Int
  model             String
  suffix            String
  colour            String
  stockyardLocation   String        @default("") // manual/admin-entered note, shown in blocking/finance/cluster views
  stockyardLiveLocation String      @default("") // auto-synced from the stockyard scanning app, by chassisNumber
  dateOfArrival       DateTime      @default(now())
  status              VehicleStatus @default(OPEN)
  hiddenFromHeatmap   Boolean       @default(false)

  // New stock-entry fields
  stockStatus       StockStatus?
  bndReportedMonth  DateTime?
  modelDisc         String?
  assignmentDate    DateTime?
  yardOut           DateTime?

  physicalStockBranch   Branch? @relation("PhysicalStockBranch", fields: [physicalStockBranchId], references: [id])
  physicalStockBranchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockings BlockingRequest[]

  @@index([model, suffix, colour])
  @@index([status])
}

model BlockingRequest {
  id                  String         @id @default(uuid())
  blockType           BlockType      @default(SOFT)
  orderId             String?
  customerName        String?
  consultantName      String?
  teamLeaderName      String?
  paymentMode         PaymentMode?
  financierBank       String?
  paymentStatus       String?
  fullPaymentAt       DateTime?
  expectedBillingDate DateTime?
  amountReceived      Float?
  receiptUrl          String?
  softBlockAt         DateTime       @default(now())
  hardBlockAt         DateTime?
  expiryAt            DateTime?
  status              BlockingStatus @default(ACTIVE)
  retailId            String?
  deliveryDocUrl      String?
  deliveredAt         DateTime?
  extendedByAdmin     Boolean        @default(false)
  adminNotes          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  user   User   @relation("UserBlockings", fields: [userId], references: [id])
  userId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  financeRecord    FinanceRecord?
  deliveryWorkflow DeliveryWorkflow?

  @@index([vehicleId])
  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@index([expiryAt])
}

// ── Finance Record ────────────────────────────────────────────────────────────

model FinanceRecord {
  id                       String    @id @default(uuid())
  blockingRequestId        String    @unique
  blockingRequest          BlockingRequest @relation(fields: [blockingRequestId], references: [id], onDelete: Cascade)

  purchaseMode             String?   // Cash, Direct, In House, No Idea
  bankName                 String?
  loanAmount               Float?
  financeStatus            String?   // Approved, Disbursed, etc.
  expectedDisbursementDate DateTime?
  otherRemarks             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModelConfig {
  id                   String   @id @default(uuid())
  modelName            String   @unique
  blockingDurationDays Int      @default(7)
  updatedAt            DateTime @updatedAt

  updatedBy   User?   @relation(fields: [updatedById], references: [id])
  updatedById String?
}

model GlobalConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedById String?
}

model VehicleRequest {
  id        String   @id @default(uuid())
  model     String
  suffix    String
  colour    String
  notes     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  @@index([status])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  previousValue Json?
  newValue      Json?
  performedAt   DateTime @default(now())

  performedBy   User   @relation(fields: [performedById], references: [id])
  performedById String

  @@index([entityType, entityId])
  @@index([performedAt])
}

// ── Delivery Workflow ─────────────────────────────────────────────────────────

model DeliveryWorkflow {
  id         String        @id @default(uuid())
  blockingId String        @unique
  blocking   BlockingRequest @relation(fields: [blockingId], references: [id])
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  stage      DeliveryStage @default(DI_DOCUMENTS)

  // Stage 1 — DI fills customer info + uploads docs
  customerName   String?
  salesOfficer   String?
  teamLeaderName String?
  panCardUrl     String?
  aadharUrl      String?
  fileFrontUrl   String?
  fileBackUrl    String?

  // Insurance stage
  insuranceType    String?   // IN_HOUSE | OUT_HOUSE
  insuranceCompany String?
  payout           Float?
  premium          Float?
  insuranceRemarks String?

  // Stage 2 — Vahaan Entry
  form21Url String?

  // Accounts — Tally
  tallyNo   String?
  tallyDate DateTime?

  // Stage 3 — Vahaan Done
  vaahanDone Boolean @default(false)

  // Accounts — Road Tax
  roadTaxReceiptNo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([stage])
}


model ChassisMap {
  id          String   @id @default(cuid())
  maskedKey   String   @unique
  realChassis String
  createdAt   DateTime @default(now())
}
